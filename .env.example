# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP port for the Express server (defaults to 3000).
PORT=3000

# MAILOO_DEMO_LOGIN: Allow one-click preview studio login (POST /api/auth/demo).
# Set to "false" to disable on a public deployment.
MAILOO_DEMO_LOGIN="true"

# MAILOO_DEV_TOKENS: If "true", auth endpoints include verification/reset tokens in JSON.
# Leave unset in any shared environment.
# MAILOO_DEV_TOKENS="true"
